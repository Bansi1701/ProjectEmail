# Copy to .env and fill in. NEVER commit .env — see docs/SECURITY.md section 8.

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32

# Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projectemail
# Neon production/staging: use the pooled TLS URI from the Neon Console, change
# postgresql:// to postgresql+asyncpg://, and keep sslmode=require. Never commit it.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0

# Inbox behaviour
INBOX_TTL_SECONDS=3600            # 10-60 min per docs; 3600 is the ceiling
MAX_MESSAGES_PER_INBOX=50
ADDRESS_ENTROPY_BYTES=12          # >= 8 bytes (64 bits). See SECURITY.md section 2

# Origins — email HTML MUST be served from a different origin than the app
APP_ORIGIN=http://localhost:3000
SANDBOX_ORIGIN=http://localhost:8001

# Local SMTP (aiosmtpd / MailHog)
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=1025
MAX_MESSAGE_SIZE_BYTES=10485760   # 10 MB

# Rate limits
RATE_LIMIT_INBOX_CREATE=10/minute
RATE_LIMIT_INBOX_READ=60/minute

# Optional
SENTRY_DSN=
TURNSTILE_SECRET_KEY=

# Copy to .env and fill in. NEVER commit .env — see docs/SECURITY.md section 8.

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-32

# Local Docker Postgres — the default for development.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/projectemail

# Neon (staging/production) — project "ProjectEmail".
# Paste the connection string from the Neon Console exactly as given. The
# postgresql:// prefix and the ?sslmode=require&channel_binding=require suffix are both
# handled for you (asyncpg rejects those libpq params — see app/core/db.py). Never commit it.
#
#   Pooled (app)       : postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   Direct (migrations): postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
#
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional. Alembic uses this instead of DATABASE_URL when set — point it at Neon's
# direct (unpooled) endpoint, because DDL through PgBouncer is unreliable.
MIGRATION_DATABASE_URL=

# Reserved for shared pub/sub and rate limits after the MVP; leave blank today.
REDIS_URL=

# Cloudflare Email Worker -> API authentication. Use a generated secret outside development.
INBOUND_WEBHOOK_SECRET=change-me-generate-with-secrets-token-urlsafe-32

# Inbox behaviour
INBOX_TTL_SECONDS=3600            # 10-60 min per docs; 3600 is the ceiling
MAX_MESSAGES_PER_INBOX=50
EXPIRY_SWEEP_INTERVAL_SECONDS=60  # physical cleanup; reads enforce expiry independently
ADDRESS_ENTROPY_BYTES=12          # >= 8 bytes (64 bits). See SECURITY.md section 2

# Origins — email HTML MUST be served from a different origin than the app
APP_ORIGIN=http://localhost:3000
SANDBOX_ORIGIN=http://localhost:8001

# Local SMTP (aiosmtpd / MailHog)
SMTP_LISTEN_HOST=0.0.0.0
SMTP_LISTEN_PORT=1025
MAX_MESSAGE_SIZE_BYTES=10485760   # 10 MB

# Rate limits
RATE_LIMIT_INBOX_CREATE=10/minute
RATE_LIMIT_INBOX_READ=60/minute

# Optional
SENTRY_DSN=
TURNSTILE_SECRET_KEY=

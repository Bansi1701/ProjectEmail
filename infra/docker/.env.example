# Host port overrides for the local Docker stack.
#
# Copy to infra/docker/.env and change only what collides. Docker Compose reads
# .env from this directory automatically. The defaults below are the conventional
# ports — you only need this file if another project on your machine already
# holds one of them.
#
# Check what is taken:  lsof -nP -iTCP:5432 -sTCP:LISTEN

WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Where sanitized email HTML will be served from. Must differ from WEB_PORT —
# it is a separate origin on purpose. See docs/SECURITY.md section 1.
SANDBOX_PORT=8001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave both unset to use the local Postgres container (the default).
#
# To point the Docker stack at Neon, uncomment and paste the Console strings
# exactly as given — no scheme or sslmode editing needed.
#
# NOTE: this is the file the Docker stack reads. backend/.env is ignored inside
# the container, because compose-injected environment variables take precedence.
#
# DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
